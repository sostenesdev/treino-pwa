# Configuração local HTTP. As senhas são geradas em .secrets/.
TREINOS_WEB_PORT=8080
TREINOS_PUBLIC_URL=http://localhost:8080
BOOTSTRAP_ADMIN_EMAIL=admin@example.invalid
BOOTSTRAP_ADMIN_NAME=Administrador

