:8443 {
    tls /certs/fullchain.pem /certs/privkey.pem
    encode zstd gzip
    header Referrer-Policy "no-referrer"
    @api path /api/*
    handle @api {
        reverse_proxy 127.0.0.1:8081
        header Cache-Control "no-store"
    }
    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}
