ARG DOTNET_SDK_IMAGE
ARG DOTNET_ASPNET_IMAGE
FROM ${DOTNET_SDK_IMAGE} AS build
WORKDIR /src
COPY backend/ ./backend/
RUN dotnet restore backend/src/Treinos.Api/Treinos.Api.csproj --locked-mode -m:1 && dotnet publish backend/src/Treinos.Api/Treinos.Api.csproj --no-restore -c Release -o /out -m:1
FROM ${DOTNET_ASPNET_IMAGE}
WORKDIR /app
COPY --from=build /out/ ./
ENV ASPNETCORE_URLS=http://127.0.0.1:8081
EXPOSE 8081
ENTRYPOINT ["dotnet","Treinos.Api.dll"]
