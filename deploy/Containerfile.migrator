FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY backend/ ./backend/
RUN dotnet publish backend/src/Treinos.Migrator/Treinos.Migrator.csproj -c Release -o /out
FROM mcr.microsoft.com/dotnet/runtime:10.0
WORKDIR /app
COPY --from=build /out/ ./
ENV TREINOS_SQL_ROOT=/opt/treinos/database/migrations
ENTRYPOINT ["dotnet","Treinos.Migrator.dll"]
