ARG DOTNET_SDK_IMAGE
ARG DOTNET_ASPNET_IMAGE
FROM ${DOTNET_SDK_IMAGE} AS build
WORKDIR /src
COPY backend/ ./backend/
RUN dotnet restore backend/src/Treinos.Migrator/Treinos.Migrator.csproj --locked-mode -m:1 && dotnet publish backend/src/Treinos.Migrator/Treinos.Migrator.csproj --no-restore -c Release -o /out -m:1
FROM ${DOTNET_ASPNET_IMAGE}
WORKDIR /app
COPY --from=build /out/ ./
ENV TREINOS_SQL_ROOT=/opt/treinos/database/migrations
ENTRYPOINT ["dotnet","Treinos.Migrator.dll"]
